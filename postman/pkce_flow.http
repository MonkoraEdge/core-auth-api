###############################################################################
# MonkoraEdge Core Auth — Authorization Code + PKCE Flow
# Full test script for RFC 7636 / OAuth 2.1 §4.1
#
# Prerequisites
# ─────────────
# • API running at http://localhost:5001
# • A registered PUBLIC client:
#     client_id       = test-spa
#     redirect_uri    = http://localhost:3000/callback
#     grant_types     = AUTHORIZATION_CODE, REFRESH_TOKEN
#     require_pkce    = true
#     require_consent = false   (or run the consent step manually)
# • An authenticated user session on the server (cookie / session ID).
#   For automated headless testing, run AuthController POST /auth/login first.
#
# VS Code REST Client extension:  https://marketplace.visualstudio.com/items?itemName=humao.rest-client
# Variables are set in the @variable = value blocks below.
###############################################################################

# ─── Shared variables ─────────────────────────────────────────────────────────
@baseUrl        = http://localhost:5001
@clientId       = test-spa
@redirectUri    = http://localhost:3000/callback
@scope          = openid profile email
@state          = csrf-state-opaque-value-32chars

# code_verifier  : 64 cryptographically random URL-safe characters (RFC 7636 §4.1)
# Generate once:  node -e "const c=require('crypto');console.log(c.randomBytes(48).toString('base64url'))"
# Paste the output below. Never reuse across requests.
@codeVerifier   = REPLACE_ME_WITH_64_CHAR_BASE64URL_RANDOM_STRING

# code_challenge : BASE64URL( SHA-256( ASCII(code_verifier) ) )
# Generate from verifier above:
#   node -e "const c=require('crypto');const v='PASTE_VERIFIER';const h=c.createHash('sha256').update(v,'ascii').digest();console.log(h.toString('base64url'))"
@codeChallenge  = REPLACE_ME_WITH_43_CHAR_BASE64URL_SHA256_OF_VERIFIER

# Filled in manually after Step 2 redirect — extract ?code= from Location header.
@authCode       = REPLACE_ME_AFTER_STEP_2

# Filled in automatically after Step 3 — paste access_token from response body.
@accessToken    = REPLACE_ME_AFTER_STEP_3

# Filled in automatically after Step 3 — paste refresh_token from response body.
@refreshToken   = REPLACE_ME_AFTER_STEP_3


###############################################################################
# STEP 1 — Generate code_verifier + code_challenge (shell helper, not HTTP)
###############################################################################
# Run this in a terminal, paste results into @codeVerifier / @codeChallenge above.
#
# PowerShell:
#   $bytes = [System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48)
#   $verifier = [Convert]::ToBase64String($bytes).TrimEnd('=').Replace('+','-').Replace('/','_')
#   $sha = [System.Security.Cryptography.SHA256]::Create()
#   $hash = $sha.ComputeHash([System.Text.Encoding]::ASCII.GetBytes($verifier))
#   $challenge = [Convert]::ToBase64String($hash).TrimEnd('=').Replace('+','-').Replace('/','_')
#   Write-Host "code_verifier : $verifier"
#   Write-Host "code_challenge: $challenge"
#
# Node.js:
#   const c = require('crypto');
#   const v = c.randomBytes(48).toString('base64url');
#   const h = c.createHash('sha256').update(v,'ascii').digest();
#   console.log('code_verifier : ' + v);
#   console.log('code_challenge: ' + h.toString('base64url'));


###############################################################################
# STEP 2 — GET /connect/authorize
#
# Expected:
#   HTTP 302  Location: http://localhost:3000/callback?code=<AUTH_CODE>&state=csrf-state-opaque-value-32chars
#   — OR —
#   HTTP 200  { "kind": "LoginRequired",  ... }  → user must authenticate first
#   HTTP 200  { "kind": "ConsentRequired", ... } → user must approve consent screen
#
# On redirect: extract the `code` query parameter from the Location header.
# VERIFY:
#   • state matches @state exactly (CSRF protection)
#   • No token appears in the redirect URL (code only, no token)
###############################################################################

### 2a — Authorize (authenticated session, no consent required)
GET {{baseUrl}}/connect/authorize
  ?response_type=code
  &client_id={{clientId}}
  &redirect_uri={{redirectUri}}
  &scope={{scope}}
  &state={{state}}
  &code_challenge={{codeChallenge}}
  &code_challenge_method=S256
  &nonce=nonce-replay-protection-value


###############################################################################
# STEP 3 — POST /connect/token  (Authorization Code exchange)
#
# Content-Type: application/x-www-form-urlencoded   ← REQUIRED by spec
# No Authorization header for public clients (no client_secret).
#
# Expected HTTP 200:
# {
#   "access_token":  "<jwt>",
#   "token_type":    "Bearer",
#   "expires_in":    ≤ 900,          ← server cap (MaxAccessTokenLifetimeSeconds)
#   "refresh_token": "<opaque>",
#   "id_token":      "<jwt>",        ← present when openid scope was requested
#   "scope":         "openid profile email"
# }
#
# Response MUST include:
#   Cache-Control: no-store
#   Pragma: no-cache
###############################################################################

### 3 — Exchange authorization code for tokens
# @name tokenResponse
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{authCode}}&redirect_uri={{redirectUri}}&client_id={{clientId}}&code_verifier={{codeVerifier}}


###############################################################################
# STEP 4 — Verify token response shape
#
# Manually inspect the response body from Step 3.
# Checklist:
#   [✓] access_token  present, non-empty string
#   [✓] token_type    == "Bearer"  (case-sensitive per RFC 6749 §7.1)
#   [✓] expires_in    integer, 1 ≤ value ≤ 900
#   [✓] refresh_token present, non-empty string (AUTHORIZATION_CODE grant always issues one)
#   [✓] id_token      present (openid scope was requested)
#   [✓] scope         contains at least "openid"
#   [✓] Cache-Control: no-store header present
#   [✓] Pragma: no-cache header present
#
# The auth code must be consumed: re-using it (Step 3 again) MUST return:
#   HTTP 400  { "error": "invalid_grant", "error_description": "..." }
###############################################################################

### 4 — Replay check: second use of the same auth code MUST fail
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{authCode}}&redirect_uri={{redirectUri}}&client_id={{clientId}}&code_verifier={{codeVerifier}}

# Expected: HTTP 400
# {
#   "error": "invalid_grant",
#   "error_description": "..."
# }


###############################################################################
# STEP 5 — Decode & verify access_token JWT claims
#
# Paste access_token into https://jwt.io or run locally:
#   node -e "const [h,p]=process.argv[1].split('.');console.log(JSON.parse(Buffer.from(p,'base64url')))" <TOKEN>
#
# Required claims (RFC 9068 §2.2 + OIDC Core §2):
#   iss   must equal AUTH_ISSUER env var ("http://localhost:5003" in dev)
#   sub   must be the authenticated user's GUID
#   aud   must equal OAUTH2_AUDIENCE env var ("https://api.example.com" in dev)
#   exp   Unix timestamp — must be iat + expires_in
#   iat   Unix timestamp — must be ≤ now
#   jti   non-empty GUID (unique per token — replay prevention)
#   typ   header claim must be "at+JWT"  (RFC 9068 §2.1, prevents ID token misuse)
#   client_id  must equal @clientId
#   scope      must match granted scope
#
# id_token additional claims (OIDC Core §2):
#   iss, sub, aud, exp, iat, nonce (must match nonce sent in Step 2)
#   at_hash  present (OIDC Core §3.1.3.6 — hash of access_token)
###############################################################################

### 5 — Call a protected endpoint to prove the access token is accepted
GET {{baseUrl}}/connect/userinfo
Authorization: Bearer {{accessToken}}

# Expected: HTTP 200
# {
#   "sub":   "<user-guid>",
#   "name":  "...",          ← when profile scope granted
#   "email": "..."           ← when email scope granted
# }


###############################################################################
# NEGATIVE TESTS
###############################################################################

### NEG-1 — Token exchange WITHOUT code_verifier  ← MUST be rejected
# OAuth 2.1 §7.9: code_verifier is REQUIRED for public clients.
# Server calls PasswordService.VerifyPkceCodeVerifier — empty verifier returns false.
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{authCode}}&redirect_uri={{redirectUri}}&client_id={{clientId}}

# Expected: HTTP 400
# {
#   "error": "invalid_grant",
#   "error_description": "code_verifier is required or does not match code_challenge."
# }


### NEG-2 — Wrong code_verifier (verifier does not match challenge hash)
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{authCode}}&redirect_uri={{redirectUri}}&client_id={{clientId}}&code_verifier=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Expected: HTTP 400
# {
#   "error": "invalid_grant",
#   "error_description": "code_verifier is required or does not match code_challenge."
# }


### NEG-3 — PKCE downgrade: code_challenge_method=plain  ← MUST be rejected at /authorize
# PasswordService.VerifyPkceCodeVerifier explicitly blocks 'plain' (OAuth 2.1 §7.9).
GET {{baseUrl}}/connect/authorize
  ?response_type=code
  &client_id={{clientId}}
  &redirect_uri={{redirectUri}}
  &scope={{scope}}
  &state={{state}}
  &code_challenge={{codeChallenge}}
  &code_challenge_method=plain

# Expected: HTTP 302  Location: {{redirectUri}}?error=invalid_request&...
# — OR HTTP 400 if redirect_uri validation fails before PKCE check


### NEG-4 — Redirect URI mismatch
GET {{baseUrl}}/connect/authorize
  ?response_type=code
  &client_id={{clientId}}
  &redirect_uri=http://evil.example.com/steal
  &scope={{scope}}
  &state={{state}}
  &code_challenge={{codeChallenge}}
  &code_challenge_method=S256

# Expected: HTTP 400  (NOT a redirect — redirect_uri not yet validated, open-redirect protection)
# {
#   "error": "invalid_request",
#   "error_description": "redirect_uri is not registered for this client."
# }


### NEG-5 — Implicit grant attempt (prohibited by OAuth 2.1)
GET {{baseUrl}}/connect/authorize
  ?response_type=token
  &client_id={{clientId}}
  &redirect_uri={{redirectUri}}
  &scope={{scope}}
  &state={{state}}

# Expected: HTTP 400
# {
#   "error": "unsupported_response_type",
#   "error_description": "Implicit grant and hybrid flows are not supported. Use response_type=code with PKCE."
# }


###############################################################################
# STEP 6 — Refresh token grant (bonus: verify rotation)
#
# Expected HTTP 200: new access_token + new refresh_token.
# Old refresh_token MUST be invalid after this (one-time use, rotation enforced).
###############################################################################

### 6a — Exchange refresh_token for new tokens
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&refresh_token={{refreshToken}}&client_id={{clientId}}

# Expected: HTTP 200 — same shape as Step 3 response (new access_token, new refresh_token).


### 6b — Replay old refresh_token after rotation  ← MUST trigger family revocation
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&refresh_token={{refreshToken}}&client_id={{clientId}}

# Expected: HTTP 400
# {
#   "error": "invalid_grant",
#   "error_description": "..."
# }
# ALSO: all tokens in this rotation family must now be revoked (theft detection cascade).
